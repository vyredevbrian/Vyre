#!/usr/bin/env bash
# vyre - tiny self-hosted Vercel. Run on the server.
set -euo pipefail

APPS=${VYRE_APPS:-/opt/vyre/apps}

usage() {
  cat <<USAGE
vyre deploy <git-url> <name> <domain> [--port 3000] [--branch main]   build + (re)deploy an app
vyre redeploy <name>                                                  pull latest and redeploy
vyre env <name> KEY=VALUE ...                                         set env vars (then redeploy)
vyre ls                                                               list apps
vyre logs <name> [-f]                                                 app logs
vyre rm <name>                                                        remove app (keeps nothing)
USAGE
  exit 1
}

meta() { grep -E "^$2=" "$APPS/$1/app.conf" | head -1 | cut -d= -f2-; }

build_and_run() {
  local name=$1 dir=$APPS/$1
  local domain port branch tag
  domain=$(meta "$name" DOMAIN); port=$(meta "$name" PORT); branch=$(meta "$name" BRANCH)

  if [ -d "$dir/src/.git" ]; then
    git -C "$dir/src" fetch --depth 1 origin "$branch"
    git -C "$dir/src" reset --hard "origin/$branch"
  else
    git clone --depth 1 --branch "$branch" "$(meta "$name" REPO)" "$dir/src"
  fi

  tag="vyre/$name:$(git -C "$dir/src" rev-parse --short HEAD)-$(date +%s)"
  if [ -f "$dir/src/Dockerfile" ]; then
    docker build -t "$tag" "$dir/src"
  else
    nixpacks build "$dir/src" --name "$tag"
  fi

  touch "$dir/.env"
  local old; old=$(docker ps -aq --filter "label=vyre.app=$name")
  docker run -d --name "vyre-$name-new" --restart unless-stopped --network vyre \
    --env-file "$dir/.env" -e PORT="$port" \
    --label "vyre.app=$name" \
    --label "caddy=$domain" \
    --label "caddy.reverse_proxy={{upstreams $port}}" \
    --label "caddy.encode=gzip zstd" \
    "$tag" >/dev/null

  sleep 5
  if [ "$(docker inspect -f '{{.State.Running}}' "vyre-$name-new")" != true ]; then
    echo "New container crashed; keeping the old version. Logs:" >&2
    docker logs --tail 50 "vyre-$name-new" >&2 || true
    docker rm -f "vyre-$name-new" >/dev/null
    exit 1
  fi
  [ -n "$old" ] && docker rm -f $old >/dev/null
  docker rename "vyre-$name-new" "vyre-$name"
  docker image prune -f >/dev/null
  echo "Deployed https://$domain"
}

cmd=${1:-}; shift || true
case $cmd in
  deploy)
    repo=${1:-}; name=${2:-}; domain=${3:-}; [ -n "$domain" ] || usage; shift 3
    port=3000; branch=main
    while [ $# -gt 0 ]; do
      case $1 in --port) port=$2;; --branch) branch=$2;; *) usage;; esac; shift 2
    done
    [[ $name =~ ^[a-z0-9][a-z0-9-]*$ ]] || { echo "name must be lowercase letters, digits, dashes" >&2; exit 1; }
    mkdir -p "$APPS/$name"
    printf 'REPO=%s\nDOMAIN=%s\nPORT=%s\nBRANCH=%s\n' "$repo" "$domain" "$port" "$branch" > "$APPS/$name/app.conf"
    build_and_run "$name" ;;
  redeploy) [ -n "${1:-}" ] || usage; build_and_run "$1" ;;
  env)
    name=${1:-}; [ -n "$name" ] || usage; shift
    mkdir -p "$APPS/$name"; touch "$APPS/$name/.env"; chmod 600 "$APPS/$name/.env"
    for kv in "$@"; do
      k=${kv%%=*}; sed -i "/^$k=/d" "$APPS/$name/.env"; echo "$kv" >> "$APPS/$name/.env"
    done
    echo "Saved. Run: vyre redeploy $name" ;;
  ls) for d in "$APPS"/*/; do [ -f "$d/app.conf" ] && echo "$(basename "$d")  https://$(meta "$(basename "$d")" DOMAIN)"; done ;;
  logs) [ -n "${1:-}" ] || usage; docker logs ${2:+"$2"} --tail 200 "vyre-$1" ;;
  rm) [ -n "${1:-}" ] || usage; docker rm -f $(docker ps -aq --filter "label=vyre.app=$1") 2>/dev/null || true; rm -rf "${APPS:?}/$1" ;;
  *) usage ;;
esac
